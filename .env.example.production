# Production Environment Variables - Backend

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/raibaar_production
MONGODB_DB_NAME=raibaar_production

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_at_least_32_characters_long
JWT_REFRESH_EXPIRE=30d

# CORS Configuration
FRONTEND_URL=https://raibaarstay.com
ALLOWED_ORIGINS=https://raibaarstay.com,https://www.raibaarstay.com

# API Configuration
API_BASE_URL=https://api.raibaarstay.com/api
PUBLIC_BASE_URL=https://api.raibaarstay.com
API_VERSION=v1
API_PREFIX=/api

# Payment Gateway Configuration
RAZORPAY_KEY_ID=your_production_razorpay_key_id
RAZORPAY_KEY_SECRET=your_production_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

STRIPE_PUBLISHABLE_KEY=your_production_stripe_publishable_key
STRIPE_SECRET_KEY=your_production_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@raibaarstay.com
FROM_NAME=Raibaar

# Cloud Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=raibaar/properties

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_SECRET=your_session_secret_key

# File Upload Configuration
MAX_FILE_SIZE=10485760
MAX_IMAGE_FILE_SIZE=5242880
MAX_VIDEO_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
UPLOAD_PATH=./uploads

# Logging Configuration
LOG_LEVEL=error
LOG_FILE=./logs/production.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Monitoring and Analytics
SENTRY_DSN=your_sentry_dsn
GOOGLE_ANALYTICS_ID=your_google_analytics_id

# Social Media Configuration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret

# SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30

# SSL Configuration
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=100

# Feature Flags
ENABLE_EMAIL_VERIFICATION=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_RATINGS=true
ENABLE_REVIEWS=true
ENABLE_WISHLIST=true

# Performance Configuration
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
ENABLE_CLUSTER=true
CLUSTER_WORKERS=0

# Development Override
DISABLE_CONSOLE_LOG=true
DISABLE_DEBUG_MODE=true
