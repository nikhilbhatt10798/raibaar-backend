# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Option 1: Local MongoDB
MONGODB_URI=mongodb://localhost:27017/raibaar

# Option 2: MongoDB Atlas (replace with your connection string)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/raibaar?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# API Configuration
API_BASE_URL=http://localhost:5000

# Payment Gateway Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Redis Configuration (for payment job queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# URLs Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
WEBHOOK_URL=https://yourdomain.com/api/payments/webhook

# Environment
NODE_ENV=development
